#!/bin/sh
# cleave pre-commit hook: block the commit unless the tree is clean.
#
#   1. no active local path overrides in Cargo.toml (e.g. ../filefacts)
#   2. `make lint` passes
#   3. `make validate` passes (`cleave validate` exits 0)
#   4. `make test` passes
#
# Install with `make install-hooks`. Bypass in an emergency with `git commit --no-verify`.

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# 1. Reject active local path overrides in Cargo.toml. Local dev sometimes
#    repoints a dep at a sibling checkout (filefacts = { path = "../filefacts" })
#    or adds a [patch] entry doing the same; those must never be committed.
#    Committed git-based patches (e.g. the [patch.crates-io] wasmtime fork) and
#    workspace-relative paths (crates/*, src/lib.rs) are fine.
if grep -nE '^[[:space:]]*[^#[:space:]].*path[[:space:]]*=[[:space:]]*"\.\.' Cargo.toml >/dev/null 2>&1; then
	echo "pre-commit: active local path override (\"../\") found in Cargo.toml:" >&2
	grep -nE '^[[:space:]]*[^#[:space:]].*path[[:space:]]*=[[:space:]]*"\.\.' Cargo.toml >&2
	echo "Comment it out before committing (or use --no-verify to bypass)." >&2
	exit 1
fi

echo "pre-commit: running make lint..."
make lint

echo "pre-commit: running make validate..."
env CLEAVE_VALIDATE_SOFT=1 make validate

echo "pre-commit: running make test..."
make test

echo "pre-commit: all checks passed."
